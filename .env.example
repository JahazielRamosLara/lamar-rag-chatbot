# =====================================================================
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =====================================================================

# ---------- AWS ----------
AWS_REGION=us-east-1
# Si no usas `aws configure` / rol IAM, descomenta y llena estas dos:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------- AWS Bedrock ----------
# Modelo de embeddings (Amazon Titan Text Embeddings V2 -> 1024 dimensiones)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# Modelo LLM que sintetiza la respuesta final.
# Alternativas segun lo que tengas habilitado en Bedrock > Model access:
#   anthropic.claude-opus-5      (mas capaz)
#   anthropic.claude-sonnet-5    (balance calidad/costo)
#   anthropic.claude-haiku-4-5   (mas rapido/barato)
BEDROCK_LLM_MODEL_ID=anthropic.claude-sonnet-5
LLM_EFFORT=low
LLM_MAX_TOKENS=1500

# ---------- Base de datos AWS RDS PostgreSQL ----------
PGHOST=mi-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=reglamento
PGUSER=postgres
PGPASSWORD=cambia-esta-password
PGSSLMODE=require

# Tabla donde viven los chunks vectorizados
DB_TABLE=reglamento_chunks

# ---------- Parametros del RAG ----------
TOP_K=6                  # cuantos chunks se le pasan al LLM
MIN_SIMILARITY=0.25      # similitud coseno minima para considerar un chunk relevante

# ---------- Servidor ----------
API_HOST=0.0.0.0
API_PORT=8000
